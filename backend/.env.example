# Local development. For hosting, enter values in the hosting dashboard.
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=stn_motors
DB_SSL=false
DB_CREATE_DATABASE=true
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# Required for a fresh production database without an active admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
